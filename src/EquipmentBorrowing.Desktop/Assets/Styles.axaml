<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Sidebar -->
  <Style Selector="Border.Sidebar">
    <Setter Property="Background" Value="#1E3A5F"/>
  </Style>

  <!-- App title in sidebar -->
  <Style Selector="TextBlock.AppTitle">
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>

  <Style Selector="TextBlock.AppSubtitle">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="#A0C4E8"/>
  </Style>

  <!-- Nav buttons -->
  <Style Selector="Button.NavButton">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Padding" Value="12 8"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
  </Style>
  <Style Selector="Button.NavButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#2A5A8F"/>
  </Style>

  <!-- Section headers -->
  <Style Selector="TextBlock.SectionHeader">
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="#1E3A5F"/>
  </Style>

  <!-- Form labels and values -->
  <Style Selector="TextBlock.FormLabel">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="#555555"/>
  </Style>
  <Style Selector="TextBlock.FormValue">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="#222222"/>
  </Style>

  <!-- Equipment card -->
  <Style Selector="Border.EquipmentCard">
    <Setter Property="Padding" Value="10 8"/>
    <Setter Property="Margin" Value="0 2"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>

  <!-- Borrowing card -->
  <Style Selector="Border.BorrowingCard">
    <Setter Property="Padding" Value="10 8"/>
    <Setter Property="Margin" Value="0 2"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>

  <!-- Item titles and subtitles -->
  <Style Selector="TextBlock.ItemTitle">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.ItemSubtitle">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="#666666"/>
  </Style>

  <!-- Availability badge -->
  <Style Selector="Border.StatusBadge">
    <Setter Property="Padding" Value="6 3"/>
    <Setter Property="CornerRadius" Value="10"/>
  </Style>
  <Style Selector="Border.StatusBadge.Available">
    <Setter Property="Background" Value="#D4EDDA"/>
  </Style>
  <Style Selector="Border.StatusBadge.Unavailable">
    <Setter Property="Background" Value="#F8D7DA"/>
  </Style>
  <Style Selector="Border.StatusBadge TextBlock.BadgeText">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Border.StatusBadge.Available TextBlock.BadgeText">
    <Setter Property="Foreground" Value="#155724"/>
  </Style>
  <Style Selector="Border.StatusBadge.Unavailable TextBlock.BadgeText">
    <Setter Property="Foreground" Value="#721C24"/>
  </Style>

  <!-- Primary button -->
  <Style Selector="Button.PrimaryButton">
    <Setter Property="Background" Value="#1E3A5F"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Padding" Value="12 8"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.PrimaryButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#2A5A8F"/>
  </Style>

  <!-- Status bar -->
  <Style Selector="Border.StatusBar">
    <Setter Property="Padding" Value="12 8"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Margin" Value="0 4 0 0"/>
  </Style>
  <Style Selector="Border.StatusBar.Success">
    <Setter Property="Background" Value="#D4EDDA"/>
  </Style>
  <Style Selector="Border.StatusBar.Error">
    <Setter Property="Background" Value="#F8D7DA"/>
  </Style>
  <Style Selector="Border.StatusBar TextBlock.StatusText">
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="Border.StatusBar.Success TextBlock.StatusText">
    <Setter Property="Foreground" Value="#155724"/>
  </Style>
  <Style Selector="Border.StatusBar.Error TextBlock.StatusText">
    <Setter Property="Foreground" Value="#721C24"/>
  </Style>

</Styles>
