<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        xmlns:views="using:EquipmentBorrowing.Desktop.Views"
        x:DataType="vm:MainWindowViewModel"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        Title="Campus Equipment Borrowing System"
        Width="1120" Height="700"
        WindowStartupLocation="CenterScreen">

	<Window.DataTemplates>
		<DataTemplate DataType="vm:EquipmentViewModel">
			<views:EquipmentView/>
		</DataTemplate>
		<DataTemplate DataType="vm:BorrowingsViewModel">
			<views:BorrowingsView/>
		</DataTemplate>
		<DataTemplate DataType="vm:StudentsViewModel">
			<views:StudentsView/>
		</DataTemplate>
		<DataTemplate DataType="vm:EquipmentManagementViewModel">
			<views:EquipmentManagementView/>
		</DataTemplate>
	</Window.DataTemplates>

	<Grid ColumnDefinitions="210,*">
		<Border Grid.Column="0" Classes="Sidebar">
			<StackPanel Spacing="8" Margin="12">
				<TextBlock Text="Campus Equipment" Classes="AppTitle" TextWrapping="Wrap"/>
				<TextBlock Text="Borrowing System" Classes="AppSubtitle" TextWrapping="Wrap" Margin="0 0 0 16"/>

				<Button Content="Catalog &amp; Checkout"
						Command="{Binding NavigateToEquipmentCommand}"
						Classes="NavButton"
						HorizontalAlignment="Stretch"/>
				<Button Content="Borrowings &amp; Search"
						Command="{Binding NavigateToBorrowingsCommand}"
						Classes="NavButton"
						HorizontalAlignment="Stretch"/>
				<Button Content="Students &amp; History"
						Command="{Binding NavigateToStudentsCommand}"
						Classes="NavButton"
						HorizontalAlignment="Stretch"/>
				<Button Content="Equipment &amp; History"
						Command="{Binding NavigateToEquipmentManagementCommand}"
						Classes="NavButton"
						HorizontalAlignment="Stretch"/>
			</StackPanel>
		</Border>

		<ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
	</Grid>
</Window>