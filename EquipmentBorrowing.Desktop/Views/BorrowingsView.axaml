<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:DataType="vm:BorrowingsViewModel"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView">
	<StackPanel Margin="20" Spacing="10">
		<TextBlock Text="Active Borrowings" FontSize="20" FontWeight="Bold"/>

		<ListBox Height="200"
                 ItemsSource="{Binding ActiveBorrowings}"
                 SelectedItem="{Binding SelectedBorrowing}"
                 Background="#f0f0f0" Margin="0,0,0,10">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<StackPanel Orientation="Horizontal" Spacing="10">
						<TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" />
						<TextBlock Text="{Binding EquipmentId, StringFormat='Eq ID: {0}'}" FontWeight="Bold" />
						<TextBlock Text="{Binding Status}" />
					</StackPanel>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<TextBlock Text="{Binding StatusMessage}" Foreground="Blue" FontWeight="Bold" />
		<Button Content="Return Selected Equipment" Command="{Binding ReturnCommand}" HorizontalAlignment="Right"/>
	</StackPanel>
</UserControl>