<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        xmlns:views="using:EquipmentBorrowing.Desktop.Views"
        x:DataType="vm:MainWindowViewModel"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        Title="Campus Equipment Borrowing System"
        Width="800" Height="450">

	<Window.DataTemplates>
		<DataTemplate DataType="vm:EquipmentViewModel">
			<views:EquipmentView />
		</DataTemplate>
		<DataTemplate DataType="vm:BorrowingsViewModel">
			<views:BorrowingsView />
		</DataTemplate>
	</Window.DataTemplates>

	<Grid RowDefinitions="Auto,*" ColumnDefinitions="200,*">
		<!-- Header -->
		<Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="Black" BorderThickness="0,0,0,1" Padding="10">
			<TextBlock Text="Campus Equipment Borrowing System" FontSize="18" FontWeight="Bold"/>
		</Border>
		<!-- Navigation Sidebar -->
		<Border Grid.Row="1" Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,1,0" Padding="10">
			<StackPanel Spacing="10">
				<Button Content="Equipment" Command="{Binding ShowEquipmentCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
				<Button Content="Borrowings" Command="{Binding ShowBorrowingsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
			</StackPanel>
		</Border>
		<!-- Content Area -->
		<Panel Grid.Row="1" Grid.Column="1" Margin="10">
			<ContentControl Content="{Binding CurrentViewModel}" />
		</Panel>
	</Grid>
</Window>